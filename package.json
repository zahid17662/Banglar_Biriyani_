    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "hono": "^4.13.14",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.75.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
